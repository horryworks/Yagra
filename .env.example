# Yagra overrides for docker-compose.deploy.yml — the pull-only composition that runs
# published images instead of building from source. That is the recommended way to deploy
# Yagra, and it needs no repository checkout: every key below has a default in the compose
# file, so this file is optional.
#
# Optional with one exception. POSTGRES_PASSWORD is baked into the database volume when it is
# first initialised, so set it BEFORE the first start — see the note on it below. The one-line
# minimum is:
#
#     printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 16)" > .env
#
# Place this file as `.env` next to the compose file ON THE MACHINE YOU ARE DEPLOYING TO.
# `.env` is gitignored — never commit real secrets.

# Image tag to deploy: `latest` (the latest stable release), a release tag such as `v0.1.19`, or
# the git SHA of a release. Usually passed on the command line; set it here to pin one machine to
# one tag. Only releases are published — there is no development channel in the registry.
# YAGRA_IMAGE_TAG=v0.1.19

# Where to pull the images from. Leave unset for the published releases. It exists so a developer
# can point one machine at a private registry holding unreleased builds; setting it by hand on a
# normal deployment will only make `pull` fail.
# YAGRA_IMAGE_REPO=ghcr.io/horryworks

# PostgreSQL password. Change it for any non-throwaway deployment.
# NOTE: postgres sets the role password only when the data directory is first initialised.
# Changing this value against an existing database does NOT rotate it — the database keeps the
# old password and core then fails to connect. Rotating means `ALTER ROLE yagra WITH PASSWORD
# '...'` inside the running container first, then this file.
POSTGRES_PASSWORD=yagra

# Host port mappings.
#
# YAGRA_WEB_PORT is the WebUI, and it is HTTPS (ADR-044) — 443 by default, so the stack is
# encrypted without anyone following a hardening procedure. The container port behind it is 8080
# in either mode; only the scheme on it changes. There is no plain-HTTP listener: a redirect was
# considered and rejected because most webhook senders do not follow one, and those that do turn a
# 301 POST into a GET — inbound events would have stopped arriving silently.
#
# ⚠️ Upgrading from before ADR-044: if this file already says 3000, you keep port 3000 and it
# becomes https://<host>:3000 — the scheme changed, not the port. Delete the override to land on
# 443. Either way, http:// no longer answers on it.
YAGRA_API_PORT=8080
YAGRA_WEB_PORT=443

# Terminate TLS in the web container (default) or serve plain HTTP from it.
#
# Set this to `off` ONLY when something in front already terminates HTTPS — an external reverse
# proxy (Caddy/Traefik/nginx) or a cloud load balancer on a private network. It is not a way to
# turn TLS off because the certificate warning is annoying; import a real certificate at
# Settings ▸ TLS instead, which takes effect in seconds with no restart.
# YAGRA_WEB_TLS=on

# Interface core's own (plaintext) API port binds to. Default 0.0.0.0 = reachable on the LAN.
#
# Browsers never use this port — the web container proxies /api/ and /mcp to core over the internal
# network. What uses it is machine clients: Prometheus scrapes, webhook senders, API scripts. It is
# left open by default so those keep working while the deployment is still on the bootstrap
# self-signed certificate; closing it in the same upgrade that introduces an untrusted certificate
# would break all of them at once with two overlapping causes.
#
# THE HARDENING STEP: once your machine clients are on https://<host>/api/v1 with a certificate
# they trust, set this to 127.0.0.1. The port stays reachable on the box and disappears from the
# network, and the TLS edge becomes the only way in. Settings ▸ TLS shows the current state.
# YAGRA_API_BIND=127.0.0.1

# Local-auth admin password seeded on first start. If left unset, Yagra generates a one-time
# random admin password and prints it once in the core logs (`docker compose logs core`) — log
# in as 'admin' with it and change it. Set this to choose your own strong password instead.
# YAGRA_ADMIN_PASSWORD=choose-a-strong-password

# Dashboard exposure. Default (unset/false): viewing requires login.
# Set true to serve node/metric/alert reads without authentication (public read-only view).
# YAGRA_PUBLIC_DASHBOARD=false

# ── Scaling / tuning ────────────────────────────────────────────────────────────────
# PostgreSQL connection-pool ceiling for the core process (default 20). One pool is shared
# by the scheduler sweep, result ingest, the northbound API, and the coordinator mirror, so
# this is the whole process's DB concurrency ceiling. At tens of thousands of nodes, raise it
# (e.g. 50–80) so a big sweep doesn't starve the API — but keep it comfortably under
# PostgreSQL's own `max_connections` (default 100), and remember every core replica draws from
# that same server budget. Too low ⇒ 5s acquire-timeout errors under load; too high ⇒ you can
# exhaust the server. Start at the default and raise only if you see acquire timeouts.
# YAGRA_PG_MAX_CONNECTIONS=20

# How many tasks write metrics to VictoriaMetrics (ADR-110 Increment 2).
# Unset => one per CPU core, capped at 4. Raise this only if the metrics queue is pinned:
#   yagra_persist_queue_depth{stream="metrics"} sitting at 8192, with
#   yagra_result_metrics_persist_dropped_total climbing.
# The reason more than one helps is that a writer can only have ONE bulk import in flight, and
# most of that time is spent waiting for VictoriaMetrics rather than using CPU -- measured at
# 50,000 nodes x 24 ports, one writer was 94% occupied at 2,500 results/s and 84% of that was the
# wait. Samples are sharded by node, so one series is always written by one task in order.
# The tier's queue and spill bounds are DIVIDED among the writers, so this cannot raise core's
# memory ceiling; and a value above 4 is clamped (and logged), because past that each writer sees
# too thin a slice of the stream to batch well. Set 1 for the old single-writer behaviour.
# Watch yagra_vm_writer_queue_depth{shard=...} for an uneven split, and remember VictoriaMetrics
# has to absorb the extra concurrency: at that load it was already using ~2.6 cores.
# YAGRA_VM_WRITERS=4

# How many poll results the metrics tier may hold while VictoriaMetrics is slow. Default 8192.
# VictoriaMetrics stalls periodically under a large series count (13.2M series on a 6 GB box
# stalled for ~20 s at a time). While it does, results keep arriving and the queue is the only
# thing between the stall and a gap in the graphs — everything past the cap is dropped, which is
# by design (metrics are the best-effort tier, ADR-025) but is still a hole.
# DO NOT guess a number: read yagra_vm_backlog_needed_high_water{shard=...} on this deployment.
# It is how deep an unbounded queue would have gone, so it is exactly the figure that sizes this.
# yagra_vm_backlog_short_episodes_total > 0 means the queue ran out at least once.
# The cost is linear and real: at 24 ports a queued result is ~21 KB, so 16384 is ~344 MB of
# worst-case resident memory. The total is DIVIDED among YAGRA_VM_WRITERS, not repeated per
# writer. Values above 131072 are clamped (and logged).
# YAGRA_RESULT_QUEUE_CAP=8192

# ── High availability (core leader election, ADR-016; optional, off by default) ─────
# Run more than one `yagra-core` against the SAME PostgreSQL/Redis/NATS/VictoriaMetrics to
# survive a core failure. When enabled, cores race for a PostgreSQL advisory lock: exactly one
# (the leader) runs the coordinator + polling scheduler + result ingest + alert/notify; the
# others are hot standbys that serve `/healthz` and return `503 /readyz` until they win the lock
# (failover is automatic, ~5s). Route API/web traffic only to the core whose `/readyz` is `200`.
# Unset/false ⇒ single active core, byte-identical to non-HA (no advisory lock is taken).
# Note: the leader holds ONE dedicated PostgreSQL connection for the lock — that is +1 on top of
# YAGRA_PG_MAX_CONNECTIONS, so size PostgreSQL `max_connections` accordingly.
# See docker-compose.ha.yml for a two-core failover-test composition.
# YAGRA_ENABLE_HA=false
# Human-readable id for this core instance, shown in HA logs (defaults to "core" if unset).
# YAGRA_CORE_ID=core-a
# Session signing key (Core HA active/active session substrate, ADR-016 Increment 2a). When set,
# logins mint stateless HMAC-signed tokens that ANY core sharing this key verifies, so a token works
# on every core and survives a core restart/failover (no forced re-login). All cores in an HA set
# MUST mount the SAME key. Generate: `openssl rand -hex 32 > ./session/session.key`. The *path* is
# the env var; the key is a mounted file, never an env var (like YAGRA_KEK_FILE). Unset ⇒ opaque
# per-process tokens, byte-identical to today. A set-but-unreadable/invalid key fails startup.
# YAGRA_SESSION_KEY_DIR=./session           # host dir holding session.key, mounted into core(s)
# YAGRA_SESSION_KEY_FILE=/etc/yagra/session.key   # path INSIDE the container (see compose mount)

# ── MCP server (ADR-028, Phase 4 inward-facing AI tool surface; optional, off by default) ─────────
# When true, core exposes a read-only Model Context Protocol tool surface at /mcp over Streamable
# HTTP (same port as the API), so an AI client (Claude Code/Desktop, or an oncall operator's AI
# client) can query node status, alerts, metrics, topology, and traffic flows. There are NO
# state-changing or device-config tools. Access requires a bearer token — either an API token minted
# in Settings ▸ API tokens (recommended for a long-lived client) or a login session token — and MCP
# is authenticated even when YAGRA_PUBLIC_DASHBOARD is on. Unset/false ⇒ /mcp is not mounted (404),
# byte-identical to pre-MCP. Additive and N-1 safe (ADR-017). Reach it from an operator's machine on
# the LAN or over the existing VPN — no public inbound exposure is required.
# YAGRA_ENABLE_MCP=false
# Optional MCP Host-header allowlist (rmcp DNS-rebinding protection). Unset/empty ⇒ any Host is
# accepted (the mandatory bearer auth is the real gate, so a rebinding attacker without a token is
# still blocked). Set to pin the allowed hosts, comma-separated — include the port the client dials,
# e.g. YAGRA_MCP_ALLOWED_HOSTS=yagra.example.com,10.0.0.5:8080
#
# ⚠️ Since ADR-044 the web container also proxies /mcp, so a client can reach it over TLS at
# https://<web-host>/mcp as well as directly on core's port. nginx passes the Host through, so an
# allowlist that only names core's `<ip>:8080` will REJECT the TLS path until the web host's name
# is added to it. An empty allowlist accepts both.
# YAGRA_MCP_ALLOWED_HOSTS=

# ── Distributed tracing (OpenTelemetry; optional, off by default) ───────────────────
# Export core+poller spans to an OTLP/HTTP collector so a poll is traceable end to end
# (core dispatch → poller poll → core ingest). Unset = logs only, zero overhead.
# YAGRA_OTEL_ENDPOINT=http://otel-collector:4318
# Sampling: at tens of thousands of nodes DON'T trace every poll. parentbased_traceidratio
# keeps a whole trace's decision consistent across the core⇄poller hop.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.01

# ── Remote-site pollers (optional; off by default) ─────────────────────────────────
# These enable the distributed poller pool (ADR-009/020). The central bus stays
# plaintext/internal until you opt in — see the "accept remote-site pollers" block in
# docker-compose.deploy.yml and docker/nats/nats-server.conf.

# NATS bus TLS+auth passwords. REQUIRED before exposing the bus to remote pollers (job
# messages carry plaintext device credentials, ADR-020). Set strong values — no default
# is provided on purpose. Placeholders below; replace before enabling.
# YAGRA_NATS_CORE_PASSWORD=replace-with-a-strong-core-bus-password
# YAGRA_NATS_POLLER_PASSWORD=replace-with-a-strong-poller-bus-password

# Host port to publish the NATS bus on (only when TLS+auth is enabled above).
# YAGRA_NATS_PORT=4222

# Directory (bind-mounted) holding the NATS server cert/key + CA. Default ./certs.
# YAGRA_CERT_DIR=./certs

# ── Per-poller credential scoping via Auth Callout (ADR-030) — NOTHING TO SET ───────
# With this on, a compromised poller can read only its OWN pool's device credentials off
# the bus, not the whole fleet's. It comes on with remote-poller acceptance above: the one
# variable that decides it is YAGRA_NATS_POLLER_PASSWORD, which the switch writes for you.
# The signing key is generated by core on first start and kept sealed in the database, and
# its public half is written into the bus's own `callout.conf` by the same one-shot that
# writes the rest of the bus configuration — so there is no key to make and none to copy.
#
# It used to be four manual steps ending in an edit to docker/nats/nats-server.conf. Do not
# put them back: that file is reinstalled from the image on every start, so the edit only
# ever survived until the next one, and the feature never actually ran anywhere.
#
# YAGRA_NATS_CALLOUT_ACCOUNT=$G             # account minted poller users join (default $G)
# The two below are the legacy path, kept only for a deployment that set it up by hand.
# A seed file here takes precedence over the key core generates for itself.
# YAGRA_CALLOUT_SEED_DIR=./callout          # host dir holding account.seed, mounted into core

# Route Meraki cloud polling to a specific poller pool (default "default").
# YAGRA_MERAKI_POOL=default

# ── Upgrading from the WebUI (Settings ▸ Upgrade) ───────────────────────────────────
# On by default in docker-compose.deploy.yml; the switch that survives an upgrade is the
# one on that page, not this file. Where RELEASES are looked for is deliberately its own
# variable — not YAGRA_IMAGE_REPO — so a box pulling its images from a private mirror
# still sees the real release list.
# YAGRA_UPGRADE_REPO=ghcr.io/horryworks
# YAGRA_UPGRADE_CHECK_SECS=86400            # how often the release list is refreshed
#
# Install from an uploaded `docker save` archive. For a site with NO reachable registry.
# ⚠️ This WIDENS the path from Yagra's Admin role to host root: `docker load` installs
# whatever the archive contains, not only the three images this compose file names. It is
# a host setting on purpose and cannot be turned on from the WebUI.
# YAGRA_UPGRADE_ALLOW_BUNDLE=0
# YAGRA_UPGRADE_BUNDLE_MAX_BYTES=4294967296 # 4 GiB; three release images are about 1 GB
# YAGRA_DOCKER_GID=0                        # only if you move the sidecar's uid off 0

# ── docker-compose.poller.yml (set these on the REMOTE poller host, not here) ───────
# The WebUI ▸ Settings ▸ Pollers ▸ "Register poller" dialog generates these. Listed here
# for reference. YAGRA_IMAGE_TAG (top of this file) also selects the poller image.
# YAGRA_BUS_URL=tls://poller:replace-with-a-strong-poller-bus-password@core.example.com:4222
# YAGRA_POLLER_ID=edge-tokyo-1
# YAGRA_POLLER_POOL=tokyo
# YAGRA_BUS_CA_FILE=/etc/yagra/certs/server-cert.pem
