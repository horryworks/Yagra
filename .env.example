# Yagra test-server overrides for docker-compose.deploy.yml.
# Copy to `.env` ON THE HOME SERVER (next to the compose file) and adjust.
# `.env` is gitignored — never commit real secrets.

# Image tag to deploy. CI sets this to the git SHA automatically; set it here only
# to pin/rollback a manual `docker compose -f docker-compose.deploy.yml up -d`.
# YAGRA_IMAGE_TAG=test

# PostgreSQL password (test default is "yagra"). Change for any non-throwaway box.
POSTGRES_PASSWORD=yagra

# Host port mappings.
YAGRA_API_PORT=8080
YAGRA_WEB_PORT=3000

# Local-auth admin password seeded on first start (change for real use).
# YAGRA_ADMIN_PASSWORD=admin

# Dashboard exposure. Default (unset/false): viewing requires login.
# Set true to serve node/metric/alert reads without authentication (public read-only view).
# YAGRA_PUBLIC_DASHBOARD=false
