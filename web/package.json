{
  "name": "yagra-web",
  "private": true,
  "version": "0.3.5",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Yagra-web — WebUI (React + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n-parity.mjs",
    "generate:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "test:ui": "playwright test --project=ui",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:upgrade": "node tests/e2e/waitForVersion.mjs && playwright test --project=e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.10.0",
    "i18next": "^26.3.4",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.1",
    "uplot": "^1.6.31",
    "zustand": "^5.0.0"
  },
  "overridesReason": {
    "js-yaml": "GHSA-5p4m-2wfm-xmqj hits 4.0.0-4.3.0; 4.3.1 is the patch in the same major. Reached only via openapi-typescript -> @redocly/openapi-core@^1.34 (dev-only, `npm run generate:api`), and openapi-typescript 7.13.0 is already latest, so no bump resolves it. Drop this once it picks up @redocly/openapi-core 2.x."
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
