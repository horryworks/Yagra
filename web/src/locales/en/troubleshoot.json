  "tools": {
    "anomaly": {
      "name": "Anomaly Detection",
      "est": "~2–4 min",
      "scope": "node group · metric families",
      "desc": "Metrics that left their own learned baseline — drifts and odd shapes",
      "reveal": "spikes · level shifts · stuck counters · seasonality breaks"
    },
    "correlation": {
      "name": "Event Correlation",
      "est": "~1–3 min",
      "scope": "incident time window",
      "desc": "Metric pairs that moved together in a window, not just the ones that alarmed",
      "reveal": "co-moving series · lead/lag relationships"
    },
    "capacity": {
      "name": "Capacity Forecast",
      "est": "~2–5 min",
      "scope": "resources · utilization %",
      "desc": "When each resource reaches 100%, projected from its utilization trend",
      "reveal": "time-to-exhaustion · growth rate"
    },
    "flap": {
      "name": "Flap Analysis",
      "est": "~1–2 min",
      "scope": "reachability · 24h–7d",
      "desc": "Nodes whose reachability keeps bouncing, ranked by flaps per hour",
      "reveal": "flap rate · churn windows"
    },
    "event_storm": {
      "name": "Event Storm",
      "est": "~1–2 min",
      "scope": "syslog / traps · per node",
      "desc": "Nodes whose event rate surged past their own baseline, ranked by the multiple",
      "reveal": "volume spikes · noisiest nodes"
    },
    "event_flap": {
      "name": "Event Flap",
      "est": "~1–2 min",
      "scope": "event rules · per node",
      "desc": "Event rules that fire and clear over and over — link and BGP session churn",
      "reveal": "fire/clear cycles · unstable links & peers"
    },
    "severity_shift": {
      "name": "Severity Shift",
      "est": "~1–2 min",
      "scope": "syslog severity · per node",
      "desc": "Nodes whose syslog mix skewed toward error or worse against their baseline",
      "reveal": "error-rate rise · severity mix"
    },
    "rule_gap": {
      "name": "Rule Gap",
      "est": "~1 min",
      "scope": "unmatched events · fleet",
      "desc": "High-volume events no rule matched, by signature — each one a rule to write",
      "reveal": "top unmatched signatures · coverage gaps"
    },
    "auth_probe": {
      "name": "Auth Probe",
      "est": "~1 min",
      "scope": "auth failures · by source",
      "desc": "Authentication failures by source — brute force or a misconfigured NMS",
      "reveal": "auth-failure bursts · offending sources"
    },
    "traffic_anomaly": {
      "name": "Traffic Anomaly",
      "est": "~1–3 min",
      "scope": "flow bytes · per node",
      "desc": "Nodes whose flow volume surged past their own baseline, ranked by the multiple",
      "reveal": "byte/packet spikes · volume baseline"
    },
    "talker_shift": {
      "name": "Talker Shift",
      "est": "~1–3 min",
      "scope": "top talkers · window vs window",
      "desc": "Addresses that became top talkers this window but were absent from the last",
      "reveal": "new dominant talkers · rank changes"
    },
    "new_destination": {
      "name": "New Destination",
      "est": "~1–3 min",
      "scope": "dst AS / port · window vs window",
      "desc": "Traffic to an AS or port that was absent from the baseline window",
      "reveal": "new external AS · new ports"
    },
    "flow_scan": {
      "name": "Scan Detection",
      "est": "~1–3 min",
      "scope": "source fan-out · per node",
      "desc": "Sources reaching an abnormal number of destinations or ports — scans and worms",
      "reveal": "scanning sources · fan-out"
    },
    "saturation": {
      "name": "Link Saturation",
      "est": "~1–3 min",
      "scope": "flow + interface · per node",
      "desc": "One conversation taking most of a busy node's traffic, with its link throughput",
      "reveal": "link hogs · dominant conversation"
    },
    "incident_correlate": {
      "name": "Incident Correlate",
      "est": "~2–4 min",
      "scope": "metric + events + flow · per node",
      "desc": "Metric, event and flow signals that coincided on a node, in arrival order",
      "reveal": "cross-signal timeline · likely root cause"
    }
  }
}
